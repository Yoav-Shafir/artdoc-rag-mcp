MINIO_ROOT_USER=overstone
MINIO_ROOT_PASSWORD=password

# === Prod S3: AWS S3 ===
S3_ENDPOINT_URL=
S3_BUCKET=overstone-wp-files-prod-sse

# === Prod RDS: read from Secrets Manager ===
AWS_SECRET_NAME=web-platform-server-v2

# === Prod ChromaDB: EC2 instance in private subnet ===
CHROMA_HOST=10.0.30.114
CHROMA_PORT=8000
CHROMA_COLLECTION=overstone-assets

EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
EMBEDDINGS_DIMENSION=1024

CHUNK_SIZE=1000
CHUNK_OVERLAP=150

BEDROCK_REGION=eu-west-2
BEDROCK_LLM_MODEL_ID=eu.amazon.nova-2-lite-v1:0
BEDROCK_LLM_REGION=eu-west-1
BEDROCK_LLM_MAX_TOKENS=1024

RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0
