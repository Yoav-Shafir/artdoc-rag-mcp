# Development environment. For production, use .env.prod instead.
# Every variable is optional; defaults live in app/config.py.

# --- MinIO container (docker compose) ---
MINIO_ROOT_USER=overstone
MINIO_ROOT_PASSWORD=change-me

# --- S3: Choose ONE (uncomment the option you want) ---

# Option 1: MinIO (local development)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=overstone-rag-documents

# Option 2: AWS S3 (dev bucket)
# S3_ENDPOINT_URL=
# S3_BUCKET=overstone-wp-files-v2-dev

# --- RDS / MySQL: read from Secrets Manager ---
AWS_SECRET_NAME=web-platform-server-v2-dev
AWS_REGION=eu-west-1

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=overstone-assets

# --- Embeddings (AWS Bedrock Titan v2) ---
EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
EMBEDDINGS_DIMENSION=1024

# --- Chunking (characters; overlap must be < size) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- AWS Bedrock ---
BEDROCK_REGION=eu-west-2
AWS_PROFILE=overstone
BEDROCK_LLM_MODEL_ID=eu.amazon.nova-2-lite-v1:0
BEDROCK_LLM_REGION=eu-west-1
BEDROCK_LLM_MAX_TOKENS=1024

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0

# --- Cognito sign-in for the MCP server (uv run poe mcp-http) ---
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
