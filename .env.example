# Copy to .env and fill in. Every variable is optional; defaults live in app/config.py.

# --- MinIO container (used by docker compose) ---
MINIO_ROOT_USER=overstone
MINIO_ROOT_PASSWORD=change-me

# --- S3 / MinIO client ---
# MinIO (local): keep S3_ENDPOINT_URL + keys. Real AWS S3: comment out these three
# lines and set S3_BUCKET; credentials then come from AWS_PROFILE (or the IAM role in AWS).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=eu-west-2
S3_BUCKET=overstone-rag-documents

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=overstone-assets

# --- Embeddings (AWS Bedrock Titan v2) ---
EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
EMBEDDINGS_DIMENSION=1024

# --- Chunking (characters; overlap must be < size) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- AWS Bedrock ---
# Real AWS credentials come from this profile (~/.aws), never from the S3_* keys above.
BEDROCK_REGION=eu-west-2
AWS_PROFILE=overstone-dev
# Claude model / inference-profile ID, set in plan step 8.1.
BEDROCK_LLM_MODEL_ID=
# eu. inference profiles aren't offered in eu-west-2; call the LLM from an EU region that has them.
BEDROCK_LLM_REGION=eu-west-1
BEDROCK_LLM_MAX_TOKENS=1024

# --- Document catalog (MySQL; read-only) ---
# Same variable names as web-platform-server-v2. The `file` table maps fileId (= S3 key) to name/category/entity.
RDS_HOSTNAME=localhost
RDS_PORT=3306
RDS_USERNAME=root
RDS_PASSWORD=change-me
RDS_DB_NAME=overstone_v2

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0
